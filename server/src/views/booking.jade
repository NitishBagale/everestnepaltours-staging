doctype html
html
  head
    title Traveller Information
    style.
      body {
        margin: 0;
        padding: 2rem;
        font-family: 'Segoe UI', sans-serif;
        background: #fff;
      }

      .container {
        padding: 1.5rem;
        background: #f8f8f8;
        border-radius: 10px;
        max-width: 500px;
      }

      .form-group {
        display: flex;
        flex-direction: column;
        margin-bottom: 1rem;
      }

      label {
        font-weight: 600;
        margin-bottom: 5px;
      }

      input, textarea {
        padding: 0.5rem;
        border: 1px solid #ccc;
        border-radius: 6px;
        font-size: 14px;
      }

  body
    .container
      h2 Traveller Details

      .form-group
        label Full Name
        input(type="text", value=traveller.fullName, readonly)

      .form-group
        label Email
        input(type="email", value=traveller.email, readonly)

      .form-group
        label Contact Number
        input(type="text", value=traveller.contactNumber, readonly)

      .form-group
        label Travel Date
        input(type="date", value=traveller.travelDate, readonly)

      .form-group
        label Number of Travellers
        input(type="number", value=traveller.noOfTravellers, readonly)

      .form-group
        label Accommodation Type
        input(type="text", value=traveller.accommodation, readonly)

      .form-group
        label Passport Number
        input(type="text", value=traveller.passport, readonly)

      .form-group
        label Additional Details
        textarea(readonly)= traveller.details
