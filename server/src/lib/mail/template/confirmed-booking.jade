doctype html
html(lang="en")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    title everest-holidaysBOOKING - One Time Password
    link(href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap" rel="stylesheet")
    style.
      body {
        font-family: 'Inter', sans-serif;
        background: #f1f5f9;
        margin: 0;
        padding: 20px 0;
        color: #1e293b;
      }
      .email-container {
        max-width: 600px;
        margin: auto;
        background: #fff;
        border-radius: 12px;
        overflow: hidden;
        box-shadow: 0 6px 20px rgba(0,0,0,0.08);
      }
      .email-header {
        background: linear-gradient(135deg, #087DC2, #0ea5e9, #10b981); /* added green (#10b981) */
        color: #fff;
        padding: 30px;
        text-align: center;
      }

      .logo img {
        max-width: 150px;
        margin-bottom: 15px;
        background-color: white;
        padding: 10px;
        border-radius: 8px;
      }
      h1 {
        margin: 0;
        font-size: 22px;
        font-weight: 600;
        text-transform: uppercase;
      }
      .email-body {
        padding: 35px 30px;
        text-align: center;
      }
      .greeting {
        font-size: 18px;
        font-weight: 500;
        margin-bottom: 15px;
      }
      .message {
        font-size: 15px;
        color: #475569;
        margin-bottom: 30px;
      }
      .otp-box {
        display: inline-block;
        background: linear-gradient(135deg, #fbbf24, #f59e0b);
        padding: 18px 28px;
        border-radius: 10px;
        font-size: 28px;
        font-weight: 700;
        letter-spacing: 6px;
        color: #1f2937;
        box-shadow: 0 4px 15px rgba(251,191,36,0.3);
        margin-bottom: 25px;
      }
      .security-note {
        font-size: 14px;
        margin: 15px 0 30px;
        color: #ef4444;
        font-weight: 600;
      }
      .package-info {
        font-size: 15px;
        color: #1e293b;
        background: #f1f5f9;
        padding: 15px;
        border-radius: 8px;
        margin-bottom: 20px;
        font-weight: 500;
      }
      .support {
        font-size: 14px;
        color: #475569;
        margin-bottom: 30px;
      }
      .footer {
        background: #1e293b;
        color: #cbd5e1;
        font-size: 13px;
        text-align: center;
        padding: 20px;
      }
      .confidentiality {
        font-size: 11px;
        color: #94a3b8;
        line-height: 1.5;
        margin-top: 15px;
        padding: 0 20px 20px;
        text-align: justify;
      }
  body
    .email-container
      .email-header
        .logo
          img(src="https://everestnepaltours.com/wp-content/uploads/2023/11/everest-vacation-logo1-e1706090032268.png", alt="everest-holidays Logo")
        h1 everest-holidaysBOOKING - One Time Password
      .email-body
        .greeting Hi #{customerName},
        .message Thank you for booking with us! Use the code below to verify your email and confirm your booking:
        .package-info 📦 Package: #{packageName}
        .otp-box #{OTP}
        .security-note Never share your code with anyone!
        .support If you have any questions, feel free to send us a message at 
          a(href="mailto:everest-holidaysbooking@gmail.com") everest-holidaysbooking@gmail.com
        .support If you did not request this code, please ignore this email.
      .footer
        | 📧 everest-holidaysbooking@gmail.com  |  📞 +977 1 4701585
        br
        | © 2025 everest-holidays Booking. All rights reserved.
      .confidentiality
        | CONFIDENTIALITY NOTICE: This transmittal is a confidential communication or may otherwise be privileged. 
        | If you are not the intended recipient, you are hereby notified that you have received this transmittal in error 
        | and that any review, dissemination, distribution or copying of this transmittal is strictly prohibited. 
        | If you have received this communication in error, please notify this office, and immediately delete this message 
        | and all its attachments, if any.
