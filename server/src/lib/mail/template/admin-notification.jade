doctype html
html(lang="en")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    title New Package Tour Booking Notification
    style.
      body {
        font-family: Arial, sans-serif;
        background-color: #f4f4f9;
        color: #333;
        margin: 0;
        padding: 0;
      }
      .email-container {
        width: 100%;
        max-width: 600px;
        margin: 20px auto;
        background-color: #fff;
        padding: 20px;
        border-radius: 8px;
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
      }
      .logo {
        text-align: center;
        margin-bottom: 30px;
      }
      .logo img {
        max-width: 150px;
        background-color: white;
        padding: 10px;
        border-radius: 8px;
      }
      .email-header {
        text-align: center;
        background-color: #087DC2;
        color: #fff;
        padding: 20px;
        border-radius: 8px 8px 0 0;
      }
      .email-header h1 {
        font-size: 24px;
        margin: 0;
      }
      .email-body {
        padding: 20px;
        font-size: 16px;
        line-height: 1.6;
      }
      .booking-details {
        background-color: #ecf0f0;
        border-left: 6px solid #FADE03;
        padding: 15px;
        margin-top: 20px;
      }
      .footer {
        text-align: center;
        font-size: 14px;
        color: #7f8c8d;
        margin-top: 30px;
      }

  body
    .email-container
      .email-header
      .logo
        img(src='https://everestnepaltours.com/wp-content/uploads/2023/11/everest-vacation-logo1-e1706090032268.png', alt='Company Logo')
        h1 New Package Tour Booking

      .email-body
        p Hello Admin,
        p
          | A new package tour booking has been placed by #{customerName}.
          br
          | Below are the booking details:

        .booking-details
          p
            | Customer Name: #{customerName}
          p
            | Email: #{email}
          p
            | Package: #{packageName}
          p
            | Travel Date: #{travelDate}
          p
            | Number of Travellers: #{noOfTravellers}
          p
            | Accommodation: #{accommodation}
          p
            | Passport Number: #{passport}
          p
            | Booking Date: #{new Date().toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
          p
            | Contact Number: #{contactNumber}
          if message
            p
              | Additional Details: #{message}
        
        p
          | Please ensure that the booking is processed smoothly.

      .footer
        p This is an automated notification. No action is required unless follow-up is necessary.

        p
          | &copy; #{new Date().getFullYear()} everest-holidays Booking. All rights reserved.
