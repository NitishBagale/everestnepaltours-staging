doctype html
html(lang="en")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    title everest-holidaysBOOKING - Booking Confirmed!
    link(href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap" rel="stylesheet")
    style.
      body {
        font-family: 'Inter', sans-serif;
        background: #f1f5f9;
        margin: 0;
        padding: 20px 0;
        color: #1e293b;
      }
      .email-container {
        max-width: 600px;
        margin: auto;
        background: #fff;
        border-radius: 12px;
        overflow: hidden;
        box-shadow: 0 6px 20px rgba(0,0,0,0.08);
      }
      .email-header {
        background: linear-gradient(135deg, #087DC2, #0ea5e9, #10b981); /* added green (#10b981) */
        color: #fff;
        padding: 30px;
        text-align: center;
      }
      .logo img {
        max-width: 150px;
        margin-bottom: 15px;
        background-color: white;
        padding: 10px;
        border-radius: 8px;
      }
      h1 {
        margin: 0;
        font-size: 22px;
        font-weight: 600;
        text-transform: uppercase;
      }
      .email-body {
        padding: 35px 30px;
      }
      .greeting {
        font-size: 18px;
        font-weight: 500;
        margin-bottom: 15px;
        text-align: center;
        color: #1e293b;
      }
      .message {
        font-size: 15px;
        color: #475569;
        margin-bottom: 30px;
        text-align: center;
      }
      .booking-details {
        background: #f8fafc;
        border-radius: 12px;
        padding: 25px;
        margin-bottom: 25px;
        border-left: 4px solid #0ea5e9;
      }
      .detail-section {
        margin-bottom: 20px;
      }
      .detail-section:last-child {
        margin-bottom: 0;
      }
      .detail-label {
        font-size: 14px;
        font-weight: 600;
        color: #0ea5e9;
        margin-bottom: 5px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
      }
      .detail-value {
        font-size: 16px;
        font-weight: 500;
        color: #1e293b;
        margin-bottom: 3px;
      }
      .detail-sub {
        font-size: 14px;
        color: #64748b;
      }
      .vehicle-specs {
        display: flex;
        gap: 10px;
        margin-top: 10px;
        flex-wrap: wrap;
      }
      .spec-item {
        background: linear-gradient(135deg, #fbbf24, #f59e0b);
        padding: 8px 12px;
        border-radius: 8px;
        font-size: 13px;
        font-weight: 600;
        color: #1f2937;
        box-shadow: 0 2px 8px rgba(251,191,36,0.2);
      }
      .trip-overview {
        background: linear-gradient(135deg, #087DC2, #0ea5e9, #10b981); /* added green (#10b981) */
        color: #fff;
        padding: 25px;
        border-radius: 12px;
        margin-bottom: 25px;
      }
      .trip-overview h3 {
        margin: 0 0 20px 0;
        font-size: 18px;
        font-weight: 600;
        text-align: center;
      }
      .feature-item {
        display: flex;
        align-items: center;
        gap: 15px;
        margin-bottom: 10px;
        font-size: 14px;
      }
      .feature-item:last-child {
        margin-bottom: 0;
      }
      .check-icon {
        font-weight: bold;
        color: #fbbf24;
        font-size: 16px;
      }
      .support {
        font-size: 14px;
        color: #475569;
        margin-bottom: 20px;
        text-align: center;
      }
      .footer {
        background: #1e293b;
        color: #cbd5e1;
        font-size: 13px;
        text-align: center;
        padding: 20px;
      }
      .confidentiality {
        font-size: 11px;
        color: #94a3b8;
        line-height: 1.5;
        margin-top: 15px;
        padding: 0 20px 20px;
        text-align: justify;
      }
      @media only screen and (max-width: 480px) {
        .email-body { padding: 25px 20px; }
        .booking-details { padding: 20px 15px; }
        .vehicle-specs { flex-direction: column; }
        .spec-item { text-align: center; }
      }

  body
    .email-container
      .email-header
        .logo
          img(src="https://everestnepaltours.com/wp-content/uploads/2023/11/everest-vacation-logo1-e1706090032268.png", alt="everest-holidays Logo")
        h1 everest-holidaysBOOKING - Booking Verified!

      .email-body
        .greeting Hi #{customerName || 'Customer'},
        .message Your package tour booking has been verified successfully! Our admin team will review and confirm your booking shortly.
        
        .booking-details
          .detail-section
            .detail-label 📦 Package Details
            .detail-value #{packageName || 'Package Tour'}
            .detail-sub Status: #{bookingStatus || 'Confirmed'}
          
          .detail-section
            .detail-label 👤 Traveller Information
            .detail-value #{customerName || 'Not provided'}
            .detail-sub Email: #{travellerEmail || 'Not provided'}
            .detail-sub Contact: #{contactNumber || 'Not provided'}
            .detail-sub Number of Travellers: #{noOfTravellers || 'Not provided'}
            .detail-sub Accommodation: #{accommodation || 'Not provided'}
          
          .detail-section
            .detail-label 📍 Pickup Location
            .detail-value #{pickupLocation || 'Not provided'}
            .detail-sub Date: #{pickupDate || 'Not provided'}
          
          .detail-section
            .detail-label 🏁 Destination
            .detail-value #{destinationLocation || 'Not provided'}
            .detail-sub Return Date: #{returnDate || 'Not provided'}
        
        .trip-overview
          h3 Your Booking Benefits
          .feature-item
            span.check-icon ✅
            span &nbsp;&nbsp;Best Price Guarantee
          .feature-item
            span.check-icon ✅
            span &nbsp;&nbsp;Flexible Payment Options
          .feature-item
            span.check-icon ✅
            span &nbsp;&nbsp;24/7 Customer Support
          .feature-item
            span.check-icon ✅
            span &nbsp;&nbsp;Professional Drivers
        
        .support If you have any questions, feel free to contact us at 
          a(href="mailto:everest-holidaysbooking@gmail.com") everest-holidaysbooking@gmail.com
        
      .footer
        | 📧 everest-holidaysbooking@gmail.com  |  📞 +977 1 4701585
        br
        | © 2025 everest-holidays Booking. All rights reserved.
      
      .confidentiality
        | CONFIDENTIALITY NOTICE: This transmittal is a confidential communication or may otherwise be privileged. 
        | If you are not the intended recipient, you are hereby notified that you have received this transmittal in error 
        | and that any review, dissemination, distribution or copying of this transmittal is strictly prohibited. 
        | If you have received this communication in error, please notify this office, and immediately delete this message 
        | and all its attachments, if any.