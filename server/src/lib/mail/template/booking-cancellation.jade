doctype html
html(lang="en")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    title everest-holidaysBOOKING - Booking Cancelled
    link(href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap" rel="stylesheet")
    style.
      body {
        font-family: 'Inter', sans-serif;
        background: #f1f5f9;
        margin: 0;
        padding: 20px 0;
        color: #1e293b;
      }
      .email-container {
        max-width: 600px;
        margin: auto;
        background: #fff;
        border-radius: 12px;
        overflow: hidden;
        box-shadow: 0 6px 20px rgba(0,0,0,0.08);
      }
      .email-header {
        background: linear-gradient(135deg, #ef4444, #dc2626);
        color: #fff;
        padding: 30px;
        text-align: center;
      }
      .logo img {
        max-width: 150px;
        margin-bottom: 15px;
        filter: brightness(0) invert(1);
        background-color: white;
        padding: 10px;
        border-radius: 8px;
      }
      .cancellation-icon {
        width: 60px;
        height: 60px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 15px;
        text-align: center;
      }
      .cancellation-icon img {
        border-radius: 0;
      }
      h1 {
        margin: 0;
        font-size: 22px;
        font-weight: 600;
        text-transform: uppercase;
      }
      .email-body {
        padding: 35px 30px;
      }
      .greeting {
        font-size: 18px;
        font-weight: 500;
        margin-bottom: 15px;
        text-align: center;
        color: #1e293b;
      }
      .message {
        font-size: 15px;
        color: #475569;
        margin-bottom: 30px;
        text-align: center;
      }
      .booking-details {
        background: #f8fafc;
        border-radius: 12px;
        padding: 25px;
        margin-bottom: 25px;
        border-left: 4px solid #ef4444;
      }
      .detail-section {
        margin-bottom: 20px;
      }
      .detail-section:last-child {
        margin-bottom: 0;
      }
      .detail-label {
        font-size: 14px;
        font-weight: 600;
        color: #ef4444;
        margin-bottom: 5px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
      }
      .detail-value {
        font-size: 16px;
        font-weight: 500;
        color: #1e293b;
        margin-bottom: 3px;
      }
      .detail-sub {
        font-size: 14px;
        color: #64748b;
        margin: 3px 0;
        line-height: 1.4;
      }
      .refund-info {
        background: linear-gradient(135deg, #059669, #10b981);
        color: #fff;
        padding: 25px;
        border-radius: 12px;
        margin-bottom: 25px;
      }
      .refund-info h3 {
        margin: 0 0 15px 0;
        font-size: 18px;
        font-weight: 600;
        text-align: center;
      }
      .refund-info p {
        font-size: 14px;
        text-align: center;
        margin: 0;
        line-height: 1.6;
      }
      .reason-section {
        background: #fef3c7;
        border: 1px solid #f59e0b;
        border-radius: 12px;
        padding: 20px;
        margin-bottom: 25px;
      }
      .reason-title {
        font-size: 16px;
        font-weight: 600;
        color: #92400e;
        margin-bottom: 10px;
      }
      .reason-text {
        font-size: 14px;
        color: #78350f;
        line-height: 1.5;
      }
      .contact-section {
        background: #f0f9ff;
        border-radius: 12px;
        padding: 25px;
        margin-bottom: 25px;
        text-align: center;
      }
      .contact-title {
        font-size: 18px;
        font-weight: 600;
        color: #0369a1;
        margin-bottom: 10px;
      }
      .contact-info {
        font-size: 14px;
        color: #475569;
        margin-bottom: 20px;
      }
      .contact-details {
        display: flex;
        justify-content: center;
        gap: 20px;
        flex-wrap: wrap;
      }
      .contact-item {
        background: #fff;
        padding: 15px;
        border-radius: 8px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.1);
        min-width: 120px;
      }
      .contact-label {
        font-size: 12px;
        font-weight: 600;
        color: #0369a1;
        text-transform: uppercase;
        margin-bottom: 5px;
      }
      .contact-value {
        font-size: 14px;
        font-weight: 500;
        color: #1e293b;
      }
      .support {
        font-size: 14px;
        color: #475569;
        margin-bottom: 20px;
        text-align: center;
      }
      .footer {
        background: #1e293b;
        color: #cbd5e1;
        font-size: 13px;
        text-align: center;
        padding: 20px;
      }
      .confidentiality {
        font-size: 11px;
        color: #94a3b8;
        line-height: 1.5;
        margin-top: 15px;
        padding: 0 20px 20px;
        text-align: justify;
      }
      @media only screen and (max-width: 480px) {
        .email-body { padding: 25px 20px; }
        .booking-details { padding: 20px 15px; }
        .contact-details { flex-direction: column; gap: 15px; }
        .contact-item { min-width: auto; }
      }

  body
    .email-container
      .email-header
        .logo
          img(src="https://everestnepaltours.com/wp-content/uploads/2023/11/everest-vacation-logo1-e1706090032268.png", alt="everest-holidays Logo")
        .cancellation-icon
          img(src="https://upload.wikimedia.org/wikipedia/commons/thumb/d/dc/Cancel_icon.svg/563px-Cancel_icon.svg.png?20180116193235", alt="Cancelled", style="width: 40px; height: 40px;")
        h1 everest-holidaysBOOKING - Booking Cancelled

      .email-body
        .greeting Hi #{customerName},
        .message We regret to inform you that your booking has been cancelled. We understand this may cause inconvenience and sincerely apologize for any disruption to your travel plans.
        
        .booking-details
          .detail-section
            .detail-label 📋 Booking Details
            .detail-value Booking ID: #{bookingId}
            if rawBookingId
              .detail-sub Reference: #{rawBookingId}
            if packageName
              .detail-sub Package: #{packageName}
          
          if pickupLocation && pickupDate && pickupDate !== 'Invalid Date' && pickupDate !== ''
            .detail-section
              .detail-label 📍 Pickup Information
              .detail-value #{pickupLocation}
              .detail-sub #{pickupDate}
          
          if destinationLocation
            .detail-section
              .detail-label 🏁 Destination
              .detail-value #{destinationLocation}
              if destinationDate && destinationDate !== 'Invalid Date' && destinationDate !== ''
                .detail-sub #{destinationDate}
        
        if cancellationReason
          .reason-section
            .reason-title ⚠️ Cancellation Reason
            .reason-text #{cancellationReason}
        
        .refund-info
          h3 💰 Refund Information
          p If you have made any payment for this booking, our team will process the refund within 5–7 business days. For any questions, please contact our support team.
        
        .contact-section
          .contact-title Need Assistance?
          .contact-info Our customer support team is here to help with alternative arrangements or any queries.
          .contact-details
            .contact-item
              .contact-label Phone
              .contact-value +977 1 4701585
            .contact-item
              .contact-label Email
              .contact-value everest-holidaysbooking@gmail.com
            .contact-item
              .contact-label WhatsApp
              .contact-value +977 9851002579
        
        .support We value your business and look forward to assisting you with future bookings. Thank you for choosing everest-holidays.
        
      .footer
        | 📧 everest-holidaysbooking@gmail.com  |  📞 +977 1 4701585
        br
        | © 2025 everest-holidays Booking. All rights reserved.
      
      .confidentiality
        | CONFIDENTIALITY NOTICE: This transmittal is a confidential communication or may otherwise be privileged. 
        | If you are not the intended recipient, you are hereby notified that you have received this transmittal in error 
        | and that any review, dissemination, distribution or copying of this transmittal is strictly prohibited. 
        | If you have received this communication in error, please notify this office, and immediately delete this message 
        | and all its attachments, if any.
