doctype html
html(lang="en")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    title everest-holidays - Booking Confirmed by Admin
    link(href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap" rel="stylesheet")
    style.
      body {
        font-family: 'Inter', sans-serif;
        background: #f1f5f9;
        margin: 0;
        padding: 20px 0;
        color: #1e293b;
      }
      .email-container {
        max-width: 600px;
        margin: auto;
        background: #fff;
        border-radius: 12px;
        overflow: hidden;
        box-shadow: 0 6px 20px rgba(0,0,0,0.08);
      }
      .email-header {
        background: linear-gradient(135deg, #10b981, #059669);
        color: #fff;
        padding: 40px 30px;
        text-align: center;
      }
      .logo img {
        max-width: 150px;
        margin-bottom: 15px;
        background-color: white;
        padding: 10px;
        border-radius: 8px;
      }
      h1 {
        margin: 0;
        font-size: 24px;
        font-weight: 700;
        text-transform: uppercase;
      }
      .confirmed-badge {
        display: inline-block;
        background: #fbbf24;
        color: #1f2937;
        padding: 10px 20px;
        border-radius: 20px;
        font-weight: 700;
        font-size: 14px;
        margin-top: 15px;
      }
      .email-body {
        padding: 35px 30px;
      }
      .greeting {
        font-size: 18px;
        font-weight: 600;
        margin-bottom: 15px;
        color: #1e293b;
      }
      .message {
        font-size: 15px;
        color: #475569;
        margin-bottom: 30px;
        line-height: 1.6;
      }
      .booking-details {
        background: #f8fafc;
        border-radius: 12px;
        padding: 25px;
        margin-bottom: 25px;
        border-left: 4px solid #10b981;
      }
      .detail-section {
        margin-bottom: 20px;
      }
      .detail-section:last-child {
        margin-bottom: 0;
      }
      .detail-label {
        font-size: 13px;
        font-weight: 600;
        color: #10b981;
        margin-bottom: 5px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
      }
      .detail-value {
        font-size: 16px;
        font-weight: 500;
        color: #1e293b;
        margin-bottom: 3px;
      }
      .detail-sub {
        font-size: 14px;
        color: #64748b;
        margin-bottom: 2px;
      }
      .highlight-box {
        background: linear-gradient(135deg, #10b981, #059669);
        color: #fff;
        padding: 25px;
        border-radius: 12px;
        margin-bottom: 25px;
        text-align: center;
      }
      .highlight-box h3 {
        margin: 0 0 10px 0;
        font-size: 18px;
        font-weight: 600;
      }
      .highlight-box p {
        margin: 0;
        font-size: 14px;
        opacity: 0.9;
      }
      .next-steps {
        background: #fef3c7;
        border-left: 4px solid #fbbf24;
        padding: 20px;
        border-radius: 8px;
        margin-bottom: 25px;
      }
      .next-steps h4 {
        margin: 0 0 10px 0;
        color: #92400e;
        font-size: 16px;
      }
      .next-steps ul {
        margin: 0;
        padding-left: 20px;
        color: #78350f;
      }
      .next-steps li {
        margin-bottom: 5px;
      }
      .support {
        font-size: 14px;
        color: #475569;
        margin-bottom: 20px;
        text-align: center;
      }
      .footer {
        background: #1e293b;
        color: #cbd5e1;
        font-size: 13px;
        text-align: center;
        padding: 20px;
      }
      @media only screen and (max-width: 480px) {
        .email-body { padding: 25px 20px; }
        .booking-details { padding: 20px 15px; }
      }

  body
    .email-container
      .email-header
        .logo
          img(src="https://everestnepaltours.com/wp-content/uploads/2023/11/everest-vacation-logo1-e1706090032268.png", alt="everest-holidays Logo")
        h1 🎉 Booking Confirmed!
        .confirmed-badge ✅ CONFIRMED BY ADMIN

      .email-body
        .greeting Dear #{customerName},
        .message Great news! Your booking has been reviewed and confirmed by our admin team. We're excited to have you join us on this adventure!
        
        .highlight-box
          h3 Your Trip is Confirmed
          p Pack your bags and get ready for an amazing experience!
        
        .booking-details
          .detail-section
            .detail-label 📦 Package Details
            .detail-value #{packageName}
          
          .detail-section
            .detail-label 👤 Traveller Information
            .detail-value #{customerName}
            .detail-sub Email: #{travellerEmail}
            .detail-sub Contact: #{contactNumber}
            .detail-sub Number of Travellers: #{noOfTravellers}
            .detail-sub Accommodation: #{accommodation}
          
          .detail-section
            .detail-label 📍 Pickup Details
            .detail-value #{pickupLocation}
            .detail-sub Date: #{pickupDate}
          
          .detail-section
            .detail-label 🏁 Destination
            .detail-value #{destinationLocation}
            .detail-sub Return Date: #{returnDate}
        
        .next-steps
          h4 📋 Next Steps:
          ul
            li Check your email for trip preparation guidelines
            li Prepare necessary documents and travel essentials
            li Our team will contact you 24-48 hours before departure
            li For any questions, reach out to our support team
        
        .support Need assistance? Contact us at 
          a(href="mailto:everest-holidaysbooking@gmail.com") everest-holidaysbooking@gmail.com
        
      .footer
        | 📧 everest-holidaysbooking@gmail.com  |  📞 +977 1 4701585
        br
        | © 2025 everest-holidays Booking. All rights reserved.
