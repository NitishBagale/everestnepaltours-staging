# Server runtime
NODE_ENV=development
PORT=4000

# Database (preferred)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DB_NAME?sslmode=require
# Optional: use for migrations if direct (non-pooled) endpoint is required
DIRECT_DATABASE_URL=

# Legacy DB fields (only if DATABASE_URL not set)
DB_NAME=
DB_USERNAME=
DB_PASSWORD=
DB_HOST=
DB_PORT=5432
DB_DIALECT=postgres
SSL=false

# Auth & app
JWT_SECRET=
SECRET_KEY=
ADMIN_MAIL=
CORS_ORIGIN=http://localhost:3000

# Email
SMTP_EMAIL=
SMTP_PASSWORD=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
