{
  "name": "express",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "start": "node ./bin/www",
    "dev": "nodemon ./bin/www",
    "db:migrate": "sequelize db:migrate",
    "db:sync": "node ./scripts/dbSync.js",
    "db:migrate:cms-sections": "node ./scripts/migrateCmsPageSections.js",
    "db:live:cms-sections": "SSL=true PGSSLMODE=require npm run db:migrate -- --env production && SSL=true PGSSLMODE=require npm run db:migrate:cms-sections",
    "db:cms-sections:cleanup-disabled": "node ./scripts/cleanupDisabledCmsSections.js",
    "db:live:cms-sections:cleanup-disabled": "SSL=true PGSSLMODE=require node ./scripts/cleanupDisabledCmsSections.js --apply",
    "etl:wordpress": "node ./scripts/importWordpressToPostgres.js"
  },
  "dependencies": {
    "axios": "^1.13.2",
    "bcryptjs": "^3.0.2",
    "cloudinary": "^1.41.3",
    "cookie-parser": "~1.4.4",
    "cors": "^2.8.5",
    "debug": "~2.6.9",
    "dompurify": "^3.2.6",
    "dotenv": "^16.5.0",
    "express": "~4.16.1",
    "jade": "~1.11.0",
    "joi": "^17.13.3",
    "jsdom": "^26.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "~1.9.1",
    "multer": "^1.4.5-lts.2",
    "multer-storage-cloudinary": "^4.0.0",
    "node-cron": "^4.1.0",
    "nodemailer": "^6.10.1",
    "pg": "^8.14.1",
    "pug": "^3.0.3",
    "react-quill": "^2.0.0",
    "sequelize": "^6.37.7",
    "sharp": "^0.34.5",
    "slugify": "^1.6.6",
    "speakeasy": "^2.0.0",
    "vary": "^1.1.2"
  },
  "devDependencies": {
    "nodemon": "^3.1.10",
    "sequelize-cli": "^6.6.3"
  }
}
